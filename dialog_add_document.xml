<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPickedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="filename.pdf"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="2"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/tvPickedSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 KB"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Document type"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDocType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vet record"
            android:checked="true"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPhoto"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPrescription"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescription"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTest"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOther"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other"/>
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes (optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>